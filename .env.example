# Application
NODE_ENV=development
PORT=3333

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habits?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# ── IA (opcional) ────────────────────────────────────────────────────────────
# Sem chave, a camada de insights responde igual, pelo redator determinístico
# (narration.source = "deterministic"). Ver docs/IA.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=20000
