# Application
NODE_ENV=development
PORT=3333

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habits?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3010

# Logging
LOG_LEVEL=debug

# ── Criação de conta (INV-42) ────────────────────────────────────────────────
# `aberto` libera POST /auth/register; `fechado` responde 403 com o motivo e as
# contas passam a nascer por `npm run criar:conta`.
#
# O default do código é `fechado` — publicada, a conta é de quem souber a URL, e
# o teto de custo do assistente é por usuário (INV-36). Aqui vem `aberto` porque
# este arquivo é o ponto de partida do ambiente de desenvolvimento, e o
# `scripts/smoke.sh` depende do registro para obter o primeiro token.
REGISTRO=aberto

# ── IA (opcional) ────────────────────────────────────────────────────────────
# Sem chave, a camada de insights responde igual, pelo redator determinístico
# (narration.source = "deterministic"). Ver docs/IA.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Modelo do ASSISTENTE. Sonnet mediu 47% mais barato que Opus com a mesma
# resposta; Haiku é PIOR nos dois eixos porque erra e tenta de novo (11 voltas).
ASSISTANT_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=20000

# ── Primitiva `query` do MCP (opcional) ──────────────────────────────────────
# Role somente-leitura, criada pela migração `rls_e_role_leitura`. Ausente, a
# primitiva não é registrada e o resto funciona igual. NUNCA aponte para o mesmo
# usuário da aplicação: o dono das tabelas escreve e contorna RLS.
DATABASE_URL_READONLY="postgresql://habits_readonly:habits_readonly_dev@localhost:5432/habits?schema=public"

# ── Assistente conversacional ────────────────────────────────────────────────
ASSISTANT_DAILY_OUTPUT_TOKENS=120000
ASSISTANT_MAX_TURNS=10
ASSISTANT_ACTION_TTL_MINUTES=30

# Motor do assistente na assinatura do Claude Code, em vez de chave da API.
# Descubra o caminho com `command -v claude`. Se ANTHROPIC_API_KEY existir, ela
# ganha — é ~10x mais barata e roda no container.
CLAUDE_CLI_PATH=
ASSISTANT_CLI_TIMEOUT_MS=120000
ASSISTANT_DAILY_COST_USD=3
