[Unit]
Description=Ponte privada Habits para Claude Code
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=nfagent
Group=nfagent
# O token OAuth continua no arquivo já usado pelo agente do Claude Code. A
# configuração do Habits contém só o segredo próprio da ponte; não duplicamos a
# credencial da assinatura em outro arquivo.
EnvironmentFile=/etc/notaflow-agent.env
EnvironmentFile=/etc/habits-claude-bridge.env
Environment=HOME=/var/lib/nfagent
Environment=USER=nfagent
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/opt/habits/claude-bridge
ExecStart=/usr/bin/node /opt/habits/claude-bridge/server.js
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/habits/claude-bridge
MemoryMax=400M

[Install]
WantedBy=multi-user.target
