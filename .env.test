# Ambiente da Camada 2. Carregado por jest.integration.config.js ANTES de
# qualquer import, e por isso ele vence o .env de desenvolvimento.
#
# O nome do banco TEM de terminar em `_test`: tests/setup.ts recusa apagar
# tabelas em qualquer outro, e essa recusa é uma trava, não um aviso.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habits_test?schema=public"
JWT_SECRET=test-only-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d
LOG_LEVEL=error

# Nenhuma chave de IA, de propósito: a Camada 2 roda no caminho determinístico
# (INV-15). Se um teste passar a exigir chave, ele quebra aqui — e é o que se quer.
