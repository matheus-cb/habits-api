# Ambiente da Camada 2. Carregado por jest.integration.config.js ANTES de
# qualquer import, e por isso ele vence o .env de desenvolvimento.
#
# O nome do banco TEM de terminar em `_test`: tests/setup.ts recusa apagar
# tabelas em qualquer outro, e essa recusa é uma trava, não um aviso.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/habits_test?schema=public"
JWT_SECRET=test-only-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d
LOG_LEVEL=error

# A Camada 2 cria usuário por HTTP em 18 pontos de 9 arquivos, sem helper
# compartilhado. Com o registro fechado (o default do código) a suíte inteira
# ficaria 401. O caso adversário de INV-42 sobrescreve isto pontualmente.
REGISTRO=aberto

# Nenhuma chave de IA, de propósito: a Camada 2 roda no caminho determinístico
# (INV-15). Se um teste passar a exigir chave, ele quebra aqui — e é o que se quer.

# Banco vazio, exigido pelo `prisma migrate diff --from-migrations`: ele aplica as
# migrações ali para comparar com o schema.prisma. Nunca recebe dado de teste.
DATABASE_URL_SHADOW="postgresql://postgres:postgres@localhost:5432/habits_shadow?schema=public"

# Mesma role, apontando para o banco de teste.
DATABASE_URL_READONLY="postgresql://habits_readonly:habits_readonly_dev@localhost:5432/habits_test?schema=public"

# ── Assistente conversacional ────────────────────────────────────────────────
ASSISTANT_DAILY_OUTPUT_TOKENS=120000
ASSISTANT_MAX_TURNS=10
ASSISTANT_ACTION_TTL_MINUTES=30

# Motor do assistente na assinatura do Claude Code, em vez de chave da API.
# Descubra o caminho com `command -v claude`. Se ANTHROPIC_API_KEY existir, ela
# ganha — é ~10x mais barata e roda no container.
CLAUDE_CLI_PATH=
ASSISTANT_CLI_TIMEOUT_MS=120000
ASSISTANT_DAILY_COST_USD=3
ASSISTANT_MODEL=claude-sonnet-5
