// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"

  // Sem `binaryTargets` explícito, o Prisma tenta DETECTAR a versão do OpenSSL na
  // imagem — e erra em Alpine moderno: ele escolhe o engine de OpenSSL 1.1, que
  // precisa de `libssl.so.1.1`, ausente desde o Alpine 3.19. O container subia e
  // morria em loop com "Error loading shared library libssl.so.1.1".
  //
  // Os dois alvos musl cobrem as duas arquiteturas em que a imagem é construída:
  // arm64 na estação de trabalho (Apple Silicon) e amd64 no runner do CI.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

/// Origem de um registro. `assistant` marca o que foi criado por um turno do
/// assistente, para o histórico continuar legível como evidência.
enum CreatedVia {
  user
  assistant
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habits        Habit[]
  conversations Conversation[]
  aiCalls       AiCall[]

  @@map("users")
}

model Habit {
  id            String     @id @default(uuid())
  title         String
  description   String?
  userId        String
  scheduledDays Int[]      @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// Soft delete. `null` = ativo. Apagar hábito destruiria todo o histórico de
  /// check-ins por cascade, e o histórico é o valor inteiro do app — então o
  /// caminho alcançável por assistente é lógico e reversível. O físico é um
  /// script local, fora do HTTP.
  deletedAt     DateTime?
  /// Identidade do lote de exclusão, separada do `deletedAt` de propósito:
  /// timestamp é fato temporal, não identidade de agrupamento.
  deleteBatchId String?
  /// Quem criou. Preenchido pelo servidor, nunca pelo corpo da requisição.
  createdVia    CreatedVia @default(user)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins  Checkin[]
  revisions HabitRevision[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("habits")
}

/// O estado ANTERIOR de um hábito, gravado antes de cada edição.
///
/// Existe porque o objetivo deste repositório promete registro "exato e
/// recuperável", e até esta migração recuperável valia para exclusão e não valia
/// para edição: `PUT /habits/:id` sobrescrevia o título e o anterior deixava de
/// existir — sem delete, sem purge, sem rastro. O soft delete cobriu exclusão e
/// deixou edição de fora, e as primitivas do MCP tornaram essa assimetria
/// alcançável por composição.
///
/// Uma linha aqui é uma versão que **deixou** de ser a corrente, e `replacedAt` é
/// o instante em que ela deixou. Não há linha para o estado atual: ele vive em
/// `habits`. Guardar o atual duplicado criaria duas fontes de verdade para o
/// mesmo valor, e a que ninguém lê é a que divergiria.
model HabitRevision {
  id            String     @id @default(uuid())
  habitId       String
  /// Os três campos que `PUT /habits/:id` sobrescreve. Se a rota passar a
  /// escrever um quarto, ele entra aqui — e o teste de INV-31 é o que cobra.
  title         String
  description   String?
  scheduledDays Int[]      @default([])
  /// Quando esta versão parou de ser a corrente. É o fato temporal, e NÃO a
  /// ordem: `TIMESTAMP(3)` empata no mesmo milissegundo. Ver `ordem`.
  replacedAt    DateTime   @default(now())
  /// A ordem de leitura do histórico, monotônica por construção.
  ///
  /// Separada de `replacedAt` pela mesma razão que `deleteBatchId` é separado de
  /// `deletedAt`: timestamp é fato temporal, não identidade nem sequência. Duas
  /// edições no mesmo milissegundo empatam em `replacedAt`, e "a mais recente"
  /// ficaria indefinida — um histórico com dois eventos trocados parece completo.
  ordem         BigInt     @default(autoincrement())
  /// Quem fez a edição que substituiu esta versão. Mesma regra de `createdVia`:
  /// vem do servidor, nunca do corpo.
  changedVia    CreatedVia @default(user)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, replacedAt])
  @@index([habitId, ordem(sort: Desc)])
  @@map("habit_revisions")
}

model Checkin {
  id            String     @id @default(uuid())
  habitId       String
  date          DateTime   @default(now()) @db.Date
  createdAt     DateTime   @default(now())
  /// Soft delete. Desfazer check-in passa a ser reversível — antes destruía o
  /// registro.
  deletedAt     DateTime?
  /// Lote de exclusão. Quando um hábito é apagado, seus check-ins ativos recebem
  /// o MESMO `deleteBatchId`, e o restore devolve só aquele lote. Antes o
  /// marcador era o `deletedAt`, e dois deletes no mesmo milissegundo faziam o
  /// restore ressuscitar o que a pessoa havia desfeito de propósito.
  deleteBatchId String?
  /// Quem registrou este check-in. O histórico só é evidência se declarar origem.
  createdVia    CreatedVia @default(user)

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  /// A unicidade real vive num índice PARCIAL criado na migração
  /// (`WHERE "deletedAt" IS NULL`), que o Prisma não sabe declarar. Este
  /// `@@unique` é mantido fora do schema de propósito — ver a migração
  /// `add_soft_delete`. Sem o parcial, marcar → desfazer → marcar no mesmo dia
  /// falharia contra uma linha invisível.
  @@index([habitId])
  @@index([habitId, deletedAt])
  @@index([deleteBatchId])
  @@map("checkins")
}

/// Uma conversa com o assistente. O histórico vive aqui, não no cliente.
///
/// No servidor porque o histórico é o que o modelo recebe a cada volta: se
/// viesse do cliente, um cliente modificado poderia reescrever o que "foi dito
/// antes" e assim reescrever o contexto de uma decisão. É a mesma razão de o
/// `userId` vir do JWT e não do corpo (INV-10).
model Conversation {
  id           String   @id @default(uuid())
  userId       String
  /// Primeira linha da primeira mensagem, para a lista de conversas.
  title        String
  /// A sessão do CLI do Claude Code, quando o motor é o CLI.
  ///
  /// Guardada porque é ela que carrega o FIO da conversa: retomando com
  /// `--resume`, o CLI já tem o histórico e o servidor não reenvia nada. Medido:
  /// uma pergunta de acompanhamento ("e qual deles tem a maior sequência?") é
  /// respondida certo sem contexto do nosso lado.
  ///
  /// O que ela NÃO faz é baratear: retomar mediu MAIS caro que abrir nova
  /// ($0.25 → $0.33), porque o custo é por volta de ferramenta e cada volta relê
  /// os ~32k tokens de contexto do próprio CLI.
  cliSessionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  actions  PendingAction[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  user
  assistant
  /// Resultado de ferramenta. Fica no histórico porque o modelo precisa vê-lo na
  /// volta seguinte, e porque é o rastro do que o assistente consultou.
  tool
}

model ConversationMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  /// Texto, ou o JSON dos blocos quando a volta tem uso de ferramenta. O formato
  /// é o da API da Anthropic para poder ser reenviado sem tradução — traduzir
  /// ida e volta seria um segundo lugar onde o histórico pode divergir.
  content        String
  /// Ordem monotônica. Mesma razão de `HabitRevision.ordem`: `createdAt` empata
  /// no mesmo milissegundo, e conversa fora de ordem é conversa diferente.
  ordem          BigInt      @default(autoincrement())
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, ordem])
  @@map("conversation_messages")
}

enum ActionStatus {
  /// Proposta, aguardando a pessoa.
  pending
  approved
  rejected
  /// A pessoa aprovou e a execução falhou. Distinto de `rejected`: um é decisão,
  /// o outro é defeito, e confundir os dois esconde erro como se fosse escolha.
  failed
  /// Passou do prazo sem decisão.
  expired
}

/// Uma escrita que o assistente PROPÔS e que ainda não aconteceu.
///
/// É o coração da fronteira: o modelo produz esta linha, e só um ato explícito da
/// pessoa a executa. O método e o caminho são conferidos contra a allowlist DUAS
/// vezes — quando a proposta nasce e quando é aprovada —, porque entre as duas
/// alguém pode ter mudado a lista, e o que vale é a lista do momento da execução.
model PendingAction {
  id             String       @id @default(uuid())
  conversationId String
  /// O `tool_use_id` da chamada do modelo. É por ele que o resultado volta ao
  /// histórico na forma que a API espera.
  toolUseId      String
  metodo         String
  path           String
  /// Corpo da requisição, como JSON. `null` quando a rota não pede corpo.
  corpo          String?
  /// O que o assistente disse que isto faz, para a pessoa ler antes de aprovar.
  resumo         String
  status         ActionStatus @default(pending)
  /// Status HTTP da execução, quando houve.
  resultStatus   Int?
  resultBody     String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("pending_actions")
}

/// Registro de toda chamada ao modelo. A auditoria que faltava.
///
/// Sem isto, `createdVia = assistant` diz que a IA escreveu e não diz o que ela
/// consultou, quanto custou, nem quantas voltas deu. Era a ausência declarada em
/// `docs/PRIMITIVAS.md`, e ela deixa de ser aceitável quando existe superfície de
/// chat: um laço de ferramentas mal conduzido gasta dinheiro real.
///
/// O que NÃO entra aqui: o conteúdo do prompt e o raciocínio do modelo (INV-16).
/// Contagem, duração, modelo e resultado — não texto.
model AiCall {
  id             String   @id @default(uuid())
  userId         String
  conversationId String?
  model          String
  inputTokens    Int
  outputTokens   Int
  /// Quantas ferramentas o modelo chamou nesta volta.
  toolCalls      Int      @default(0)
  durationMs     Int
  /// `stop_reason` da API, ou o código do erro.
  outcome        String
  /// Qual motor atendeu: `api` (chave da Anthropic) ou `cli` (Claude Code).
  engine         String   @default("api")
  /// Custo em dólares, quando o motor informa. O SDK não informa — ele devolve
  /// tokens e o preço muda; o CLI devolve `total_cost_usd` calculado.
  ///
  /// `Decimal` e não `Float`: somar centavos em ponto flutuante acumula erro, e
  /// esta coluna existe para virar um total que a pessoa vai ler.
  costUsd        Decimal? @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_calls")
}
